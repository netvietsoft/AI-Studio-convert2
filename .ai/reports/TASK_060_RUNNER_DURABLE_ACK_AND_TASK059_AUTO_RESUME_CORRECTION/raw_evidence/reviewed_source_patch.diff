+    def test_replaced_canonical_lease_rejects_old_failure(self):
+        self.action.write_text(self.writer_action(
+            f"command = writer / '.ai/commands/running/{COMMAND_ID}.json'\n"
+            "data = json.loads(command.read_text())\n"
