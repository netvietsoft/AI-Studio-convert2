      "decoded_text": "#ifdef GL_ES\nprecision highp  float;\n#else\n#define highp\n#define mediump\n#define lowp\n#endif\nvarying vec2 v_texCoord;\nuniform sampler2D texturesrc;\nuniform sampler2D textureblack;\nvoid main()\n{\n    vec4 src = texture2D(texturesrc,vec2(v_texCoord.x,v_texCoord.y));\n    vec4 black = texture2D(textureblack,vec2(v_texCoord.x,v_texCoord.y));\n    float blackvalue = 1.0 - black.r;\n    float val = src.r;\n    if(black.r > 0.0)\n    {\n        if(src.r > blackvalue)\n        {\n            val = blackvalue;\n        }\n    }\n    gl_FragColor = vec4(val,val,val, val);\\xcfs\\x87",
