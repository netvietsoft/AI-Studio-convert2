      },
      {
        "line": 12,
        "text": ""
      },
      {
        "line": 13,
        "text": "export function signalPlan(options: SignalOptions): SignalPlan {"
      },
      {
        "line": 14,
        "text": "  if (options.platform === \"win32\") {"
      },
      {
        "line": 15,
        "text": "    return { type: \"tree\", command: \"taskkill\", args: [\"/PID\", String(options.pid), \"/T\", \"/F\"] };"
