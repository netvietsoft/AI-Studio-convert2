        "line": 146,
        "text": "    async stop(reason) {"
      },
      {
        "line": 147,
        "text": "      if (process.platform === \"win32\") await cleanup;"
      },
      {
        "line": 148,
        "text": "      if (state === \"exited\") return;"
      },
      {
        "line": 149,
        "text": "      if (state === \"starting\") rejectReady(new AntigravityError(\"Antigravity startup canceled\"));"
      },
      {
        "line": 150,
        "text": "      clearTimeout(startupDeadline);"
      },
      {
        "line": 151,
        "text": "      state = \"stopping\";"
      },
      {
        "line": 152,
        "text": "      if (process.platform === \"win32\") {"
      },
      {
        "line": 153,
        "text": "        // Node signal emulation kills only the leader; taskkill must see the live tree."
      },
      {
        "line": 154,
        "text": "        cleanup = Promise.resolve(signalGroup(child, \"SIGKILL\"));"
      },
      {
        "line": 155,
        "text": "        await cleanup;"
