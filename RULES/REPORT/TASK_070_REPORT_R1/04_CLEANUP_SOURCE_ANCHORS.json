        "line": 159,
        "text": "      if (reason === \"close\") child.stdin.end();"
      },
      {
        "line": 160,
        "text": "      else signalGroup(child, \"SIGINT\");"
      },
      {
        "line": 161,
        "text": "      const terminate = setTimeout(() => signalGroup(child, \"SIGTERM\"), 1000);"
