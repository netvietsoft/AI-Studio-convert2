        "text": "    state = \"stopping\";"
      },
      {
        "line": 128,
        "text": "    cleanup = Promise.resolve(signalGroup(child, \"SIGKILL\"));"
      },
      {
        "line": 129,
        "text": "    // The stop operation awaits cleanup and owns reporting its failure."
