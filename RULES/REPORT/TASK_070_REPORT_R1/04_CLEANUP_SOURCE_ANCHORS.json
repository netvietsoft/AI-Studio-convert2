      {
        "line": 18,
        "text": "}"
      },
      {
        "line": 19,
        "text": ""
      },
      {
        "line": 20,
        "text": "export function signalProcess(options: SignalOptions): void | Promise<void> {"
      },
      {
        "line": 21,
        "text": "  const plan = signalPlan(options);"
      },
      {
        "line": 22,
        "text": "  if (plan.type === \"tree\") return killTree(plan);"
      },
      {
        "line": 23,
        "text": "  try {"
      },
      {
        "line": 24,
        "text": "    process.kill(plan.pid, plan.signal);"
      },
      {
        "line": 25,
        "text": "  } catch (error) {"
      },
      {
        "line": 26,
        "text": "    if (!(error instanceof Error && \"code\" in error && error.code === \"ESRCH\")) throw error;"
      },
      {
        "line": 27,
        "text": "  }"
      },
      {
        "line": 28,
        "text": "}"
      },
      {
        "line": 29,
        "text": ""
      },
      {
        "line": 30,
        "text": "async function killTree(plan: Extract<SignalPlan, { type: \"tree\" }>): Promise<void> {"
      },
      {
        "line": 31,
        "text": "  try {"
      },
      {
        "line": 32,
        "text": "    await execCommand(plan.command, plan.args, { shell: false });"
      },
      {
        "line": 33,
        "text": "  } catch (error) {"
      },
      {
        "line": 34,
        "text": "    // taskkill reports an already-exited PID with exit code 128."
      },
      {
        "line": 35,
        "text": "    if (!(error instanceof Error && \"code\" in error && error.code === 128)) throw error;"
      },
      {
        "line": 36,
        "text": "  }"
