      },
      {
        "line": 137,
        "text": "      if (state !== \"ready\")"
      },
      {
        "line": 138,
        "text": "        return Promise.reject(new AntigravityError(\"Antigravity is not ready\"));"
      },
      {
        "line": 139,
        "text": "      return new Promise<void>((resolve, reject) => {"
      },
      {
        "line": 140,
        "text": "        child.stdin.write(encodePrompt(text), (error) => {"
      },
      {
        "line": 141,
        "text": "          if (error) reject(error);"
      },
      {
        "line": 142,
        "text": "          else resolve();"
      },
      {
        "line": 143,
        "text": "        });"
      },
      {
        "line": 144,
        "text": "      });"
      },
      {
        "line": 145,
        "text": "    },"
      },
